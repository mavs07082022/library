$books = [];
$categories = [];
$bookMessage = '';
$bookSearchTerm = isset($_GET['search']) ? $_GET['search'] : '';

try {
    // Fetch all books - your schema uses 'cover_image' as text
    $books = supabaseRequest('books?select=*');
    // Fetch all categories
    $categories = supabaseRequest('categories?select=*');
} catch (Exception $e) {
    $bookMessage = '❌ Failed to load books: ' . $e->getMessage();
}

// Handle Add/Edit Book
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['action'])) {
    $action = $_POST['action'];
    $title = $_POST['title'] ?? '';
    $author = $_POST['author'] ?? '';
    $isbn = $_POST['isbn'] ?? '';
    $publisher = $_POST['publisher'] ?? '';
    $year_published = $_POST['year_published'] ?? null;
    $category_id = $_POST['category_id'] ?? null;
    $quantity = intval($_POST['quantity'] ?? 1);
    $available = intval($_POST['available'] ?? 1);
    $location = $_POST['location'] ?? '';
    $description = $_POST['description'] ?? '';
    $cover_image = $_POST['cover_image'] ?? '';

    if (!empty($title) && !empty($author)) {
        try {
            $data = [
                'title' => $title,
                'author' => $author,
                'isbn' => $isbn,
                'publisher' => $publisher,
                'year_published' => $year_published ? intval($year_published) : null,
                'category_id' => $category_id ?: null,
                'quantity' => $quantity,
                'available' => $available,
                'location' => $location,
                'description' => $description
            ];

            if (!empty($cover_image)) {
                $data['cover_image'] = $cover_image;
            }

            if ($action === 'edit' && !empty($_POST['book_id'])) {
                supabaseRequest('books?id=eq.' . $_POST['book_id'], 'PATCH', $data);
                $bookMessage = '✅ Book updated!';
            } else {
                supabaseRequest('books', 'POST', $data);
                $bookMessage = '✅ Book added!';
            }
            echo '<meta http-equiv="refresh" content="1">';
        } catch (Exception $e) {
            $bookMessage = '❌ Failed to save book: ' . $e->getMessage();
        }
    }
}

// Handle Delete Book
if (isset($_GET['delete_book'])) {
    try {
        supabaseRequest('books?id=eq.' . $_GET['delete_book'], 'DELETE');
        $bookMessage = '✅ Book deleted!';
        echo '<meta http-equiv="refresh" content="1">';
    } catch (Exception $e) {
        $bookMessage = '❌ Failed to delete book: ' . $e->getMessage();
    }
}

// Filter books for display
$filteredBooks = array_filter($books, function($b) use ($bookSearchTerm) {
    if (empty($bookSearchTerm)) return true;
    $search = strtolower($bookSearchTerm);
    return strpos(strtolower($b['title'] ?? ''), $search) !== false ||
           strpos(strtolower($b['author'] ?? ''), $search) !== false ||
           strpos(strtolower($b['isbn'] ?? ''), $search) !== false;
});

// Create category map for display
$catMap = [];
foreach ($categories as $cat) {
    $catMap[$cat['id']] = $cat['name'];
}

// Function to get placeholder color
function getPlaceholderColor($id) {
    $colors = ['#667eea', '#764ba2', '#f093fb', '#4facfe', '#43e97b', '#fa709a', '#fee140', '#a18cd1', '#fbc2eb', '#8ec5fc'];
    return $colors[abs($id) % count($colors)];
}
